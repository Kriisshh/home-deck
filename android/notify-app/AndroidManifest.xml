<?xml version="1.0" encoding="utf-8"?>
<!-- Home Deck Notify: forwards the phone's notifications to the always-on phone's wake service,
     which Home Deck reads. No UI beyond one settings screen; Android starts it only for notifications. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kriisshh.homedeck.notify"
    android:versionCode="3"
    android:versionName="1.2">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="Home Deck Notify"
        android:icon="@drawable/ic_bell"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <activity android:name=".SettingsActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ForwardService"
            android:exported="true"
            android:label="Home Deck Notify"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
